{% macro ssl(domain) -%}
ssl_certificate     {{ ssl_live_path }}/{{ domain }}/fullchain.pem;
ssl_certificate_key {{ ssl_live_path }}/{{ domain }}/privkey.pem;
{%- endmacro %}

#— FRONT : redirige HTTP → HTTPS
server {
  listen 80;
  server_name {{ domain_front }} {{ domain_api }};

  return 301 https://$host$request_uri;
}

#— FRONT HTTPS
server {
  listen 443 ssl http2;
  server_name {{ domain_front }};

  {{ ssl(domain_front) }}
  include {{ letsencrypt_conf }};
  ssl_dhparam {{ letsencrypt_dhparam }};

  location / {
    proxy_pass http://127.0.0.1:{{ front_external_port }};
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}


#— API HTTPS
server {
  listen 443 ssl http2;
  server_name {{ domain_api }};

  {{ ssl(domain_front) }}
  include {{ letsencrypt_conf }};
  ssl_dhparam {{ letsencrypt_dhparam }};

  location / {
    proxy_pass http://127.0.0.1:{{ back_external_port }};
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
